# AI Tutor Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# APPLICATION
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================================
# DATABASE (Neon Postgres)
# ============================================================================
# Get from Neon Console: Project Settings > Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/ai_tutor?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/ai_tutor?sslmode=require

# ============================================================================
# NEON AUTH (Managed Better Auth)
# ============================================================================
# Get from Neon Console: Auth > Configuration
NEON_AUTH_SECRET=your-super-secret-key-min-32-chars
NEON_AUTH_TRUSTED_DOMAINS=localhost:3000,your-preview.vercel.app

# OAuth Providers (configure in Neon Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ============================================================================
# NEON REALTIME
# ============================================================================
# Get from Neon Console: Realtime > Configuration
NEON_REALTIME_ENDPOINT=wss://realtime.neon.tech
NEON_REALTIME_SECRET=your-realtime-secret

# ============================================================================
# NEON FUNCTIONS
# ============================================================================
# Deployed via: neonctl functions deploy tutor
# NEON_FUNCTIONS_URL=https://your-function.neon.app

# ============================================================================
# NEON OBJECT STORAGE
# ============================================================================
# Get from Neon Console: Storage > Buckets
# NEON_STORAGE_ACCESS_KEY=
# NEON_STORAGE_SECRET_KEY=
# NEON_STORAGE_ENDPOINT=https://your-bucket.neonstorage.app
# NEON_STORAGE_REGION=us-east-1

# ============================================================================
# AI PROVIDER (OpenRouter)
# ============================================================================
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Tutor Platform

# ============================================================================
# WEB PUSH (VAPID Keys)
# ============================================================================
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxI4O8-FbRouAevSmBQ6o18hgE4nSG3qwvJTfKc-ls
VAPID_SUBJECT=mailto:admin@ai-tutor.com

# ============================================================================
# LTI 1.3 ADVANTAGE
# ============================================================================
LTI_ISSUER=http://localhost:3000
LTI_CLIENT_ID=ai-tutor-platform
LTI_DEPLOYMENT_ID=default
LTI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
LTI_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
LTI_JWKS_URL=http://localhost:3000/api/lti/jwks

# ============================================================================
# EMAIL (Resend / SendGrid / Nodemailer)
# ============================================================================
# EMAIL_FROM=AI Tutor <noreply@ai-tutor.com>
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
# SENTRY_DSN=
# POSTHOG_KEY=
# VERCEL_ANALYTICS_ID=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_PUSH=true
NEXT_PUBLIC_ENABLE_LTI=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false