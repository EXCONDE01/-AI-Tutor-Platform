# AI Tutor Platform - Preview Branch Environment
# 
# This file is used by GitHub Actions for PR preview deployments.
# Values marked with {{PLACEHOLDER}} are injected at deploy time.
#
# DO NOT EDIT THIS FILE DIRECTLY - it's a template for CI/CD.
# Actual values are set via GitHub Actions secrets and Neon branch outputs.

# ============================================================================
# DATABASE (Neon Preview Branch) - INJECTED AT DEPLOY TIME
# ============================================================================
# Set by: neon-deploy job -> create-branch step
DATABASE_URL="{{NEON_DATABASE_URL}}"

# Direct connection for migrations (same branch, no pooler)
DATABASE_URL_DIRECT="{{NEON_DATABASE_URL_DIRECT}}"

# ============================================================================
# AUTHENTICATION - INJECTED AT DEPLOY TIME
# ============================================================================
# From GitHub secrets
BETTER_AUTH_SECRET="{{BETTER_AUTH_SECRET}}"

# Preview URL format: https://pr-<number>.vercel.app
# Set by: vercel-deploy job
BETTER_AUTH_URL="{{VERCEL_PREVIEW_URL}}"

# Trusted origins for preview branches
TRUSTED_ORIGINS="https://*.vercel.app,https://*.neonfunctions.dev"

# OAuth Providers (from GitHub secrets)
GOOGLE_CLIENT_ID="{{GOOGLE_CLIENT_ID}}"
GOOGLE_CLIENT_SECRET="{{GOOGLE_CLIENT_SECRET}}"

GITHUB_CLIENT_ID="{{GITHUB_CLIENT_ID}}"
GITHUB_CLIENT_SECRET="{{GITHUB_CLIENT_SECRET}}"

MICROSOFT_CLIENT_ID="{{MICROSOFT_CLIENT_ID}}"
MICROSOFT_CLIENT_SECRET="{{MICROSOFT_CLIENT_SECRET}}"
MICROSOFT_TENANT_ID="{{MICROSOFT_TENANT_ID}}"

# ============================================================================
# NEON SERVICES - INJECTED AT DEPLOY TIME
# ============================================================================
# From GitHub secrets
NEON_API_KEY="{{NEON_API_KEY}}"
NEON_PROJECT_ID="{{NEON_PROJECT_ID}}"

# Neon Realtime (auto-configured per branch)
NEON_REALTIME_URL="wss://realtime.neon.tech"
NEON_REALTIME_TOKEN="{{NEON_REALTIME_TOKEN}}"

# Neon Function URL (set by neon-deploy job)
NEON_TUTOR_FUNCTION_URL="{{NEON_TUTOR_FUNCTION_URL}}"

# Object Storage (auto-configured per branch)
NEON_STORAGE_ENDPOINT="https://storage.neon.tech"
NEON_STORAGE_ACCESS_KEY="{{NEON_STORAGE_ACCESS_KEY}}"
NEON_STORAGE_SECRET_KEY="{{NEON_STORAGE_SECRET_KEY}}"
NEON_STORAGE_REGION="us-east-1"
NEON_STORAGE_BUCKET_ARTIFACTS="artifacts"
NEON_STORAGE_BUCKET_EXPORTS="exports"

# ============================================================================
# LLM PROVIDER (OpenRouter) - FROM GITHUB SECRETS
# ============================================================================
OPENROUTER_API_KEY="{{OPENROUTER_API_KEY}}"

# Model preferences
OPENROUTER_DEFAULT_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_FALLBACK_MODELS="openrouter/free,particle-ai/particle-1:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# ============================================================================
# LTI 1.3 - PREVIEW CONFIGURATION
# ============================================================================
# Preview issuer matches preview URL
LTI_ISSUER="{{VERCEL_PREVIEW_URL}}"
LTI_CLIENT_ID="ai-tutor-platform-preview"
LTI_JWKS_URL="{{VERCEL_PREVIEW_URL}}/api/lti/jwks"
LTI_AUTH_URL="{{VERCEL_PREVIEW_URL}}/api/lti/auth"
LTI_TOKEN_URL="{{VERCEL_PREVIEW_URL}}/api/lti/token"

# LTI Keys (generate per preview branch or use shared dev keys)
LTI_JWK_PRIVATE_KEY="{{LTI_JWK_PRIVATE_KEY}}"
LTI_JWK_PUBLIC_KEY="{{LTI_JWK_PUBLIC_KEY}}"

LTI_SCOPES="https://purl.imsglobal.org/spec/lti-ags/scope/lineitem https://purl.imsglobal.org/spec/lti-ags/scope/result.readonly https://purl.imsglobal.org/spec/lti-ags/scope/score https://purl.imsglobal.org/spec/lti-nrps/scope/contextmembership.readonly"

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Set by vercel-deploy job
NEXT_PUBLIC_APP_URL="{{VERCEL_PREVIEW_URL}}"
NEXT_PUBLIC_APP_NAME="AI Tutor Platform (Preview)"
NODE_ENV="production"

# Feature flags (all enabled for preview testing)
ENABLE_LTI="true"
ENABLE_REALTIME="true"
ENABLE_ARTIFACTS="true"
ENABLE_INTERVENTIONS="true"
ENABLE_COMPLIANCE="true"

# Rate limiting (stricter for preview)
RATE_LIMIT_REQUESTS="50"
RATE_LIMIT_WINDOW="60"

# Session
SESSION_MAX_AGE="2592000" # 30 days

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Vercel Analytics (auto-enabled)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Sentry (optional, separate preview project)
SENTRY_DSN="{{SENTRY_DSN_PREVIEW}}"
SENTRY_ORG="{{SENTRY_ORG}}"
SENTRY_PROJECT="ai-tutor-preview"

# Log level
LOG_LEVEL="info"

# ============================================================================
# PREVIEW-SPECIFIC
# ============================================================================
# Preview branch identifier (injected by GitHub Actions)
PREVIEW_BRANCH_NAME="{{NEON_BRANCH_NAME}}"
PREVIEW_PR_NUMBER="{{GITHUB_PR_NUMBER}}"

# Disable seeding in preview
SEED_DATABASE="false"

# Mock external services for preview testing
MOCK_LTI="false"
MOCK_OPENAI="false"