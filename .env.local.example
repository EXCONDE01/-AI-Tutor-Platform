# AI Tutor Platform - Local Development Environment
# 
# Copy this file to .env.local and fill in your values.
# This file is gitignored - never commit actual secrets!
#
# Quick setup:
# 1. Create a Neon project at https://console.neon.tech
# 2. Enable Auth, Realtime, Functions, and Object Storage
# 3. Create an OpenRouter account at https://openrouter.ai
# 4. Fill in the values below

# ============================================================================
# DATABASE (Neon Postgres) - REQUIRED
# ============================================================================
# Get from Neon Console > Project > Connection Details
# Use "Pooled connection" for serverless, "Direct connection" for migrations
DATABASE_URL="postgresql://your-user:your-pass@ep-xxx.us-east-1.aws.neon.tech/ai_tutor?sslmode=require"
DATABASE_URL_DIRECT="postgresql://your-user:your-pass@ep-xxx.us-east-1.aws.neon.tech/ai_tutor?sslmode=require"

# ============================================================================
# AUTHENTICATION - REQUIRED
# ============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-generated-secret-here"

# Local development URL
BETTER_AUTH_URL="http://localhost:3000"

# Trusted origins for local dev
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001"

# OAuth for local development (optional - can use email/password only)
# Create OAuth apps at:
# - Google: https://console.cloud.google.com/apis/credentials
# - GitHub: https://github.com/settings/developers
# - Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Microsoft OAuth (optional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# ============================================================================
# NEON SERVICES - REQUIRED for full functionality
# ============================================================================
# Get from Neon Console > Account > API Keys
NEON_API_KEY=""
NEON_PROJECT_ID=""

# These are auto-populated when you enable services in Neon Console
# Or run: neonctl projects describe <project-id> --output json
NEON_REALTIME_URL="wss://realtime.neon.tech"
NEON_REALTIME_TOKEN=""

# Tutor function URL (after deploying function locally or to preview)
NEON_TUTOR_FUNCTION_URL=""

# Object Storage (S3-compatible) - Get from Neon Console > Storage
NEON_STORAGE_ENDPOINT="https://storage.neon.tech"
NEON_STORAGE_ACCESS_KEY=""
NEON_STORAGE_SECRET_KEY=""
NEON_STORAGE_REGION="us-east-1"
NEON_STORAGE_BUCKET_ARTIFACTS="artifacts"
NEON_STORAGE_BUCKET_EXPORTS="exports"

# ============================================================================
# LLM PROVIDER (OpenRouter) - REQUIRED for tutor agent
# ============================================================================
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# Optional model preferences - FREE MODELS ONLY
OPENROUTER_DEFAULT_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_FALLBACK_MODELS="openrouter/free,particle-ai/particle-1:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# ============================================================================
# LTI 1.3 - OPTIONAL (for LMS integration testing)
# ============================================================================
# For local LTI testing, you can use ngrok to expose localhost
# LTI_ISSUER="https://your-ngrok-url.ngrok-free.app"
# LTI_CLIENT_ID="ai-tutor-platform"
# LTI_JWKS_URL="https://your-ngrok-url.ngrok-free.app/api/lti/jwks"
# LTI_AUTH_URL="https://your-ngrok-url.ngrok-free.app/api/lti/auth"
# LTI_TOKEN_URL="https://your-ngrok-url.ngrok-free.app/api/lti/token"

# Generate RSA keys for LTI (run once):
# openssl genrsa -out private.key 2048
# openssl rsa -in private.key -pubout -out public.key
# LTI_JWK_PRIVATE_KEY="$(cat private.key | sed ':a;N;$!ba;s/\n/\\n/g')"
# LTI_JWK_PUBLIC_KEY="$(cat public.key | sed ':a;N;$!ba;s/\n/\\n/g')"

LTI_JWK_PRIVATE_KEY=""
LTI_JWK_PUBLIC_KEY=""

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Tutor Platform (Dev)"
NODE_ENV="development"

# Feature flags (all enabled for local dev)
ENABLE_LTI="true"
ENABLE_REALTIME="true"
ENABLE_ARTIFACTS="true"
ENABLE_INTERVENTIONS="true"
ENABLE_COMPLIANCE="true"

# Development helpers
SEED_DATABASE="true"
MOCK_LTI="false"
MOCK_OPENAI="false"

# Log level (debug for development)
LOG_LEVEL="debug"

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================
# Sentry for error tracking (optional)
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Vercel Analytics (optional, auto-enabled on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""